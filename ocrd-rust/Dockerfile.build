# linux/amd64 build of the Rust OCR daemon, for publishing as a release asset.
#
# WHY A CONTAINER AND NOT A CROSS-COMPILE: leptess is a bindgen binding against
# the SYSTEM tesseract and leptonica. It needs those libraries' headers at build
# time and links their .so at run time, so the build has to happen on the
# userland it will run on. Cross-compiling would mean staging a whole foreign
# sysroot to no benefit.
#
# WHY THIS BASE: the same digest-pinned golang:alpine the Go daemon builds in
# and the consuming CI worker runs. The Go toolchain in it is unused here --
# what matters is that the musl userland producing this binary is byte-identical
# to the one executing it, so a version skew in libtesseract cannot appear
# between build and run.
FROM public.ecr.aws/docker/library/golang:1.27-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc

# rust/cargo: the toolchain. musl-dev + pkgconf: the C linkage leptess needs to
# find and link the libraries. clang/clang-dev/llvm-dev: bindgen parses the
# tesseract and leptonica headers through libclang at build time -- without the
# -dev packages it fails at "unable to find libclang", not at compile.
# tesseract-ocr-dev + leptonica-dev: the headers and .so files themselves.
RUN apk add --no-cache \
        rust \
        cargo \
        musl-dev \
        pkgconf \
        clang \
        clang-dev \
        llvm-dev \
        tesseract-ocr-dev \
        leptonica-dev

COPY . /src
WORKDIR /src

# --locked: build the dependency versions the committed Cargo.lock names, never
# a fresh resolve. The kernels in src/kstream.rs were measured against exactly
# these versions, so a silent minor bump would invalidate the benchmark this
# implementation was chosen on.
RUN cargo build --release --locked \
        && mkdir -p /out \
        && cp target/release/ocrd /out/ocrd-rust-linux-amd64 \
        && /out/ocrd-rust-linux-amd64 --version
