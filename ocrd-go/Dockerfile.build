# Linux/amd64 build of ocrd-go. Built as an image so the compile runs INSIDE
# the (possibly remote/WSL) docker daemon -- a bind mount of the Windows
# checkout cannot work against a remote dockerd, but a build context can.
# The binary is extracted with docker create + docker cp (see Makefile).
# Same digest-pinned base as the route66 CI worker image, so the produced
# binary runs against exactly the musl/tesseract userland it will ship into.
FROM public.ecr.aws/docker/library/golang:1.27-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc
RUN apk add --no-cache gcc musl-dev pkgconf tesseract-ocr-dev leptonica-dev
COPY . /src
WORKDIR /src
ENV CGO_ENABLED=1
RUN go build -o /out/ocrd-go-linux-amd64 .
